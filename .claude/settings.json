{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.ts)",
            "command": "npx ng lint 2>&1 | tail -5",
            "timeout": 30,
            "statusMessage": "Linting TypeScript..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx ng serve*)",
      "Bash(npx ng build*)",
      "Bash(npx ng lint*)",
      "Bash(npx ng generate*)",
      "Bash(npx playwright test*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo *)",
      "Bash(lsof -i *)",
      "mcp__playwright__*",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
